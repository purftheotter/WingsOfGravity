use crate::math::vec2math::Vec2;

pub struct Circle {
    pub center: Vec2,
    pub radius: f32,
}

impl Circle {
    pub fn new(c: Vec2, r: f32) -> Self {
        Self {center:c,radius:r}
    }
}

pub struct Polygon {
    pub points: Vec<Vec2>,
    pub center: Vec2,
}

impl Polygon {
    pub fn new(points: Vec<Vec2>, center: Vec2) -> Self {
        Self { points, center }
    }
}
